# Use applicable legislation property instead of foaf page

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcatap:  <http://data.europa.eu/r5r/>
PREFIX foaf:	<http://xmlns.com/foaf/0.1/>

DELETE
	{	?s foaf:page ?uri }
INSERT 
	{ 	?s dcatap:applicableLegislation ?uri }
WHERE 
	{	?s foaf:page ?uri 
		FILTER (STRSTARTS(STR(?uri), "http://data.europa.eu/eli"))
	}