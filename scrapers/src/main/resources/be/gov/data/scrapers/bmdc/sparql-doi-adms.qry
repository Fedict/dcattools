# ADMS identifier for DOI

PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dcterms: <http://purl.org/dc/terms/> 
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

DELETE {
		?s dcterms:identifier ?doi }
INSERT {
		?s adms:identifier ?adms .
		?adms a adms:Identifier .
		?adms skos:notation ?doi .
		?adms adms:schemaAgency "DOI Foundation" }
WHERE
	{	?s dcterms:identifier ?doi .
		?s dcterms:identifier ?id .
		BIND (IRI(
				CONCAT("http://data.gov.be/.well-known/genid/adms/bmdc/", 
					REPLACE(
						STR(?id), "https://metadata.naturalsciences.be/", ""
					)
				)
			) as ?adms)
		FILTER (STRSTARTS(STR(?doi), "https://doi.org") && (STR(?doi) != STR(?id)))
	}
