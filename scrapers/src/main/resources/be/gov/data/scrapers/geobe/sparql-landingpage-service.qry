# Add landing page if not present

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/> 

INSERT
	{ 	?s dcat:landingPage ?page }
WHERE
	{ 	?s a dcat:DataService .
		?s foaf:isPrimaryTopicOf ?rec .
		?rec dcterms:identifier ?id .
		BIND(
			IRI(
				CONCAT("https://www.geo.be/catalog/details/",  ?id)
				)
			AS ?page)
		FILTER NOT EXISTS { ?s dcat:landingPage ?url }
	}
