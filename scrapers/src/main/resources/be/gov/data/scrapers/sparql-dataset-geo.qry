# Set dataset type to geospatial

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX geodcatap: <http://data.europa.eu/930/>

INSERT 
	{ 	?s dcterms:type <http://publications.europa.eu/resource/authority/dataset-type/GEOSPATIAL> }
WHERE
	{	?s a dcat:Dataset .
		?s geodcatap:resourceType ?type }