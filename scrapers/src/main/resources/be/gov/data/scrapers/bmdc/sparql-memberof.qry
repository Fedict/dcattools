# Add memberOf relation for RBINS subdivisions

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

DELETE 
	{	?s ?prop ?org .
		?org foaf:name ?name .
		?org ?p ?o }
INSERT 
	{ 	?s ?prop ?neworg .
		?neworg foaf:name ?name .
		?neworg ?p ?o .
		?neworg org:memberOf ?uri }
WHERE
	{	?s ?prop ?org .
		?org foaf:name ?name .
		?org ?p ?o .
		?uri skos:altLabel ?str .
		BIND (IRI
				(CONCAT(
					STR(?uri), "#", STRAFTER(STR(?org), "/org/"))
			) AS ?neworg)
		FILTER (CONTAINS(?name, ?str))
		FILTER (STRSTARTS(STR(?org), "http://data.gov.be/.well-known/genid/org/"))
	}