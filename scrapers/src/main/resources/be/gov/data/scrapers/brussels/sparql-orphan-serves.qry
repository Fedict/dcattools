# Remove servesDataset referencing orphan datasets

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>

DELETE {
	?cat dcat:dataset ?d .
	?s dcat:servesDataset ?d .
	?d a dcat:Dataset }  
WHERE {
	?s dcat:servesDataset ?d .
	?d a dcat:Dataset
	OPTIONAL { ?cat dcat:dataset ?d }
	FILTER NOT EXISTS { ?d dcterms:title ?o }
}
