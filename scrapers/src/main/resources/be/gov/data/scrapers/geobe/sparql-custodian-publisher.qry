# Use the organization of the custodian or originator as publisher when publisher is missing

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX geodcatap: <http://data.europa.eu/930/>

INSERT 
	{	?s dcterms:publisher ?publ }
WHERE
	{ 	 
		?s a ?cl .
		{	?s geodcatap:custodian|geodcatap:originator ?cust .
			?cust org:memberOf ?publ
		}
		UNION
		{	?s geodcatap:custodian|geodcatap:originator ?cust .
			FILTER STRSTARTS(STR(?cust), "https://org.belgif.be/")
			FILTER NOT EXISTS { ?cust org:memberOf ?publ }
		}
		VALUES ?cl { dcat:Dataset dcat:DataService }
		FILTER NOT EXISTS { ?s dcterms:publisher ?o }
	}