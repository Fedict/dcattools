# Move HvD subject or theme to specific property

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcatap: <http://data.europa.eu/r5r/>
PREFIX dcterms: <http://purl.org/dc/terms/>

DELETE 
	{ 	?s ?rel ?hvd }
INSERT
	{ 	?s dcatap:hvdCategory ?hvd }
WHERE
	{ 	?s ?rel ?hvd
		VALUES ?rel { dcterms:subject dcat:theme }
		FILTER (CONTAINS(STR(?hvd), "data.europa.eu/bna/"))
	}
