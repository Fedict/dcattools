## Connect dataservices to the full dataset metadata, instead of the stub

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>

DELETE {
		?cat dcat:dataset ?s .
		?service dcat:servesDataset ?d .
		?d dcterms:identifier ?id .
		?d ?p ?o }
INSERT 
	{	?service dcat:servesDataset ?uri }
WHERE
	{	?s a dcat:Dataset .
		?s dcterms:identifier ?id .
		?s dcterms:description ?desc .
		?service dcat:servesDataset ?d .
		?d dcterms:identifier ?id .
		?d ?p ?o
		OPTIONAL { ?cat dcat:dataset ?s }
		FILTER NOT EXISTS (?d dcterms:description ?desc)
		FILTER (isLiteral(?id))
	}