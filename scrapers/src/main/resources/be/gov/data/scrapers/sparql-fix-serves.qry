## Connect dataservices to the full dataset metadata, instead of the stub

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

DELETE {
		?cat dcat:dataset ?d .
		?service dcat:servesDataset ?d .
		?d dcterms:identifier ?id .
		?d ?p ?o }
INSERT 
	{	?service dcat:servesDataset ?s }
WHERE
	{	
		?service dcat:servesDataset ?d .
		?d dcterms:identifier ?id .
		?d ?p ?o .
		?rec a dcat:CatalogRecord .
		?rec dcterms:identifier ?id .
		?s foaf:isPrimaryTopicOf ?rec .
		?s a dcat:Dataset
		OPTIONAL { ?cat dcat:dataset ?d }
		FILTER NOT EXISTS { ?d dcterms:description ?desc }
		FILTER (isLiteral(?id))
	}