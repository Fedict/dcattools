# Add landing page based on catalogrecord ID

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/> 

INSERT
	{ 	?s dcat:landingPage ?page }
WHERE
	{ 	?s a ?cl .
		?s foaf:isPrimaryTopicOf ?rec .
		?rec dcterms:identifier ?id .
		VALUES (?cl ?page) {
			(dcat:Dataset "https://www.geo.be/catalog/details/")
			(dcat:DataService "https://www.geo.be/catalog/details/")
		}
		BIND(
			IRI(
				CONCAT(?page,  ?id)
				)
			AS ?page)
		FILTER NOT EXISTS { ?s dcat:landingPage ?url }
	}
