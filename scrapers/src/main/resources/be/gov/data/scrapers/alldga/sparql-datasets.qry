# Add all datasets to data.gov.be catalog

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcatap: <http://data.europa.eu/r5r/>

DELETE {
		?cat dcat:dataset ?s .
		?s a dcat:Dataset .
		?s ?p ?o .
		?o ?x ?y }
WHERE {
		?cat dcat:dataset ?s .
		?s a dcat:Dataset .
		?s ?p ?o .
		OPTIONAL { ?o ?x ?y }
		FILTER NOT EXISTS { ?s dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2022/868/oj> } 
	}