# Fix organizations incorrectly having class person, and being part of itself

PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX org: <http://www.w3.org/ns/org#>

DELETE	{	?org a foaf:Person .
			?org org:memberOf ?org }
INSERT	{	
			?org a foaf:Organization }
WHERE	{
			?org a foaf:Person .
			?org org:memberOf ?org
		}
