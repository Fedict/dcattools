# Add given / familyname based on name

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

DELETE
	{	?person foaf:name ?name }
INSERT
	{	?person foaf:name ?name2 .
		?person foaf:givenName ?given .
		?person foaf:familyName ?family
	}
WHERE
	{	?person a foaf:Person .
		?person foaf:name ?name .
		BIND (REPLACE(STR(?name), " *, *", ", ") as ?name2)
		BIND (IF(
					CONTAINS(?name, ","), REPLACE(STRBEFORE(STR(?name), ","), "^ *([^ ]+) *$", "$1"),
					?unbound)
				as ?family)
		BIND (IF(
					CONTAINS(?name, ","), REPLACE(STRAFTER(STR(?name), ","), "^ *([^ ]+) *$", "$1"),
					?unbound)
				 as ?given)
	}