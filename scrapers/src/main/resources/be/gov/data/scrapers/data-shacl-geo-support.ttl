# Geo data for improving SHACL validation

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#> 

 <https://sws.geonames.org/2802361/> a dcterms:Location ;
	skos:prefLabel "België"@nl, "Belgique"@fr, "Belgium"@en, "Belgien"@de ;
	dcat:centroid "POINT(4.67 50.64)"^^geo:wktLiteral ;
	dcat:bbox "POLYGON((2.54 51.51,6.41 51.51,6.41 49.49,2.54 49.49,2.54 51.51)) "^^geo:wktLiteral .

<https://sws.geonames.org/3337387/> a dcterms:Location ;
	skos:prefLabel "Wallonia"@en, "Wallonië"@nl, "Wallonie"@fr, "Wallonie"@de  ;
	dcat:centroid "POINT(5.00 50.32)"^^geo:wktLiteral ;
	dcat:bbox "POLYGON((2.54 50.85,6.41 50.85,6.41 49.49,2.54 49.49,2.54 50.85))"^^geo:wktLiteral .

<https://sws.geonames.org/3337388/> a dcterms:Location ;
	skos:prefLabel "Vlaanderen"@nl, "Flandre"@fr, "Flanders"@en, "Flandern"@de ;
	dcat:centroid "POINT(4.24 51.04)"^^geo:wktLiteral ;
	dcat:bbox "POLYGON((2.54 51.51,5.92 51.51,5.92 50.67,2.54 50.67,2.54 51.51))"^^geo:wktLiteral .
