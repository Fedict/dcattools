# Convert vocab belgif themes to EU Publication office themes

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

DELETE 
	{ 	?s ?rel ?vocab .
		?vocab ?p ?o }
INSERT
	{ 	?s dcat:theme ?theme }
WHERE
	{ 	?s ?rel ?vocab .
		OPTIONAL { ?vocab ?p ?o }
		VALUES ?rel { dcat:theme dcterms:subject }
		BIND (IRI(
				CONCAT("http://publications.europa.eu/resource/authority/data-theme/",
					STRAFTER(STR(?vocab), "datatheme/")
				)
			)as ?theme)
		FILTER (CONTAINS(STR(?vocab), "vocab.belgif.be"))
	}
