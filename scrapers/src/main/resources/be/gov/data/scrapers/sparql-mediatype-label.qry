# Set preflabel for IANA mediatypes

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

INSERT {	
		?mt a skos:Concept .
		?mt skos:prefLabel ?lbl
	}
WHERE {
		?mt a dcterms:MediaType .
		BIND ( 
			STRAFTER(STR(?mt), "https://www.iana.org/assignments/media-types/")
			as ?lbl)
		FILTER (STRSTARTS(STR(?mt),  "https://www.iana.org/assignments/media-types/"))
		FILTER NOT EXISTS { ?mt skos:prefLabel ?o }
	}
	
