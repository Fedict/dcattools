# Add IRI to HVD legislation on distribution if set on dataset

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcatap: <http://data.europa.eu/r5r/>

INSERT
	{ 	?dist dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> }
WHERE
	{ 	?s a dcat:Dataset .
		?s dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> .
		?s dcat:distribution ?dist 
		FILTER NOT EXISTS { ?dist dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> }
	}