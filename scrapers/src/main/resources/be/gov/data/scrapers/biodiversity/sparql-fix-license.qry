# Remove duplicate (possibly conflicting) license info

PREFIX dcterms: <http://purl.org/dc/terms/>

DELETE
	{ 	?s dcterms:license ?lic .
		?s dcterms:rights ?url }
INSERT
	{ 	?s dcterms:license ?url }
WHERE
	{ 	?s dcterms:license ?lic .
		?s dcterms:rights ?url 
		FILTER (STRSTARTS(STR(?url), "http"))
	}
